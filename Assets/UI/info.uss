:root {
}

#Cover {
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    background-color: rgb(0, 0, 0);
    position: absolute;
    transition-duration: 1s;
}

.Scene {
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    max-width: 100%;
    max-height: 100%;
    position: absolute;
}

.Background {
    flex-grow: 1;
    background-color: rgb(184, 255, 220);
    align-items: auto;
    align-content: auto;
    width: 100%;
    height: 100%;
}

.LevelButton {
    align-items: auto;
    align-self: center;
    justify-content: flex-start;
    align-content: auto;
    position: relative;
    width: 12%;
    flex-shrink: initial;
    flex-grow: initial;
    flex-direction: column;
    flex-basis: auto;
    height: 57.6%;
    padding-left: 0;
    padding-right: 0;
    margin-right: 4.75%;
    margin-bottom: 1%;
    margin-left: 0%;
    margin-top: 0%;
    padding-bottom: 0;
    padding-top: 0;
    left: auto;
    font-size: 150px;
    -unity-font-style: bold;
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    flex-wrap: nowrap;
    background-color: rgba(255, 255, 255, 0);
    background-size: cover;
    background-image: url("project://database/Assets/Images/Button/metal.png?fileID=2800000&guid=19b1c700b6d7e4345a818e2d786ddabb&type=3#metal");
    border-left-color: rgb(186, 186, 186);
    border-right-color: rgb(186, 186, 186);
    border-top-color: rgb(186, 186, 186);
    border-bottom-color: rgb(186, 186, 186);
    background-repeat: no-repeat;
    text-overflow: clip;
    color: rgb(59, 59, 59);
    text-shadow: 5px 10px 0 rgb(40, 40, 40);
}

.Frame {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 2%;
    top: 0%;
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/Images/frame7.png?fileID=2800000&guid=733fac43a14440f4d83644a3ce60a124&type=3#frame7");
    background-repeat: no-repeat no-repeat;
    background-size: 1% 1%;
}
