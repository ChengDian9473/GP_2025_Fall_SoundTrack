                <ui:Label text="Label" name="TutorialLabel" style="top: auto; align-items: auto; justify-content: flex-start; align-content: auto; height: 30%; width: 100%; background-color: rgba(255, 0, 0, 0.73); -unity-text-align: upper-left; align-self: auto; position: relative; left: auto; font-size: 60px; padding-top: 1%; padding-right: 2%; padding-bottom: 1%; padding-left: 2%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/NotoSansTC-VariableFont_wght.ttf?fileID=12800000&amp;guid=762375260485d31468b20650d50979a0&amp;type=3#NotoSansTC-VariableFont_wght&quot;); -unity-font-style: bold; flex-basis: initial; flex-shrink: initial; flex-grow: initial; bottom: -66%;" />
