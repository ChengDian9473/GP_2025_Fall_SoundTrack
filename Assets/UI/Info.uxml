                <ui:Button text="Start" name="StartButton" class="LevelButton" style="font-size: 75px; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; bottom: auto; top: 50%; text-shadow: 5px 10px 0 rgb(127, 127, 127); height: 10%; width: 20%;" />
