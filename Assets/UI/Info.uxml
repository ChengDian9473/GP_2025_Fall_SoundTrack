                    <ui:Label text="Times Hit: " name="HPLabel" style="justify-content: flex-start; align-self: auto; color: rgb(255, 255, 255); align-items: auto; font-size: 60px; -unity-text-align: middle-left; padding-left: 3%; height: 10%; flex-shrink: 1; flex-grow: 1;" />
