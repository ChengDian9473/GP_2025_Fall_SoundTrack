        <ui:VisualElement name="Tutorial" enabled="true" style="flex-grow: 1; align-items: auto; flex-shrink: 1; width: 100%; height: 100%; min-width: 100%; max-width: 100%; max-height: 100%; min-height: 100%; position: absolute; background-color: rgba(255, 255, 255, 0); opacity: 1; align-content: auto; align-self: auto; display: flex; justify-content: flex-end;">
