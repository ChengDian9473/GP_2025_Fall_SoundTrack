        <ui:VisualElement name="Setting" enabled="true" class="Scene" style="background-color: rgba(127, 127, 127, 0.75); flex-grow: 0; top: 0; left: 0; opacity: 1; color: rgb(0, 0, 0); white-space: normal; flex-wrap: nowrap; -unity-text-align: upper-left; align-self: flex-start; justify-content: center; display: none;">
