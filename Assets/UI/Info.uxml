<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/info.uss?fileID=7433441132597879392&amp;guid=0b506292139f4da49b540f312aa610eb&amp;type=3#info" />
    <ui:VisualElement name="Root" style="flex-grow: 1; opacity: 1;">
        <ui:VisualElement name="MainMenu" enabled="true" class="Scene" style="background-color: rgb(0, 0, 0); flex-grow: 0; top: 0; left: 0; opacity: 1; display: flex;">
