        <ui:VisualElement name="Level" enabled="true" style="flex-grow: 1; align-items: auto; flex-shrink: 1; width: 1920px; height: 100%; min-width: 100%; max-width: 100%; max-height: 100%; min-height: 100%; position: absolute; background-color: rgba(255, 255, 255, 0); opacity: 1; display: flex; align-self: auto; background-image: url(&quot;project://database/Assets/Images/Test/frame.png?fileID=2800000&amp;guid=e0bf41c837d81864493db23bf2779e8d&amp;type=3#frame&quot;); left: auto; background-size: 100% 100%; background-repeat: round round;">
